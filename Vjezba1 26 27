/*1. Napisati program koji prvo pročita koliko redaka ima datoteka, tj. koliko ima studenata
zapisanih u datoteci. Nakon toga potrebno je dinamički alocirati prostor za niz struktura
studenata (ime, prezime, bodovi) i učitati iz datoteke sve zapise. Na ekran ispisati ime,
prezime, apsolutni i relativni broj bodova.
Napomena: Svaki redak datoteke sadrži ime i prezime studenta, te broj bodova na kolokviju.
relatvan_br_bodova = br_bodova/max_br_bodova*100*/
#include <stdio.h>
#include <stdlib.h>

#define MAX_CHAR 20
#define MAX_POINT  150.0
#define PROBLEM_UCITAVANJA -1

typedef struct Ucenik{
    char name[MAX_CHAR];
    char surname[MAX_CHAR];
    int points;
    double rel_bod;
}Ucenik;

int brojiLinije();
int ucitajPodatke(Ucenik*, int);

int main(){
    int BrojLinija = brojiLinije(); //pozivanjem BrojLinija poziva se funkcija BrojiLinije.
    Ucenik* Ucenici = malloc(BrojLinija * sizeof(*Ucenici));
    if (Ucenici == NULL)
        return -9;
    if(BrojLinija <=0){
        printf("Došlo je do problema prilikom očitavanja podataka");
            return -2;
    }
    else{
        printf("Zapisano je %d Ucenika", BrojLinija);
    }
    ucitajPodatke(Ucenici, BrojLinija);
    
    for (int i = 0; i < BrojLinija; i++) //ispis podataka o studentima
		printf("\n%s %s %d od %0.0lf (%0.2lf) ", Ucenici[i].name, Ucenici[i].surname, Ucenici[i].points, MAX_POINT, Ucenici[i].rel_bod);
    free(Ucenici); //oslobađanje memorije
return 0;
}

int brojiLinije(){
    int Brojac = 0;
    FILE* Imenik=fopen("yes.txt", "r");
    
    if (!Imenik)
        return PROBLEM_UCITAVANJA;
        
    while(!feof(Imenik))
        if (fgetc(Imenik) == '\n')
            Brojac++;
    fclose(Imenik);
    return Brojac;
}

int ucitajPodatke(Ucenik* Ucenici, int BrojLinija){
    FILE* Imenik= fopen("yes.txt", "r");
    
    if (!Imenik)
        return PROBLEM_UCITAVANJA;
    for (int i = 0; i < BrojLinija; i++) {
    fscanf(Imenik, "%s %s %d", Ucenici[i].name, Ucenici[i].surname, &Ucenici[i].points); //spremanje podataka u strukturu
		Ucenici[i].rel_bod = ((double)Ucenici[i].points / MAX_POINT) * 100.0; //ako je ispit od 115 bodova
	} //buffer?
	fclose(Imenik);
	return 0;
}
